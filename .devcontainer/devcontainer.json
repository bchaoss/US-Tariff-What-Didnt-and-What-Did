{
  "name": "Node + Python Features",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:0-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "innoverio.vscode-dbt-power-user",
        "evidence.evidence-vscode",
        "svelte.svelte-vscode",
        "eamodio.gitlens"
      ]
    }
  },
  "forwardPorts": [
    3000
  ],
  "initializeCommand": {
    "bi local env setup": "echo \"EVIDENCE_SOURCE__us_tariff_dataset__token=${MOTHERDUCK_TOKEN}\" > reports/.env"
  },
  "postCreateCommand": {
    "dbt dependencies": "pip install -r requirements.txt",
    "bi dependencies": "cd reports/ && npm install && npm run sources"
  }
}