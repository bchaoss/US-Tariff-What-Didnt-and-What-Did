{
  "name": "Node + Python Features",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:0-20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.13"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "innoverio.vscode-dbt-power-user",
        "evidence.evidence-vscode",
        "svelte.svelte-vscode",
        "eamodio.gitlens"
      ]
    }
  },
  "containerEnv": {
    "MOTHERDUCK_TOKEN": "${localEnv:MOTHERDUCK_TOKEN}"
  },
  "forwardPorts": [3000],
  "postCreateCommand": "bash ./.devcontainer/setup.sh"
}